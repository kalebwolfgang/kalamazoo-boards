{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kalebwolfgang.github.io/kalamazoo-boards/schemas/meetings.schema.json",
  "title": "Kalamazoo Boards — per-board meeting data file",
  "description": "Schema for data/<board>.json files produced by scraper.py.",
  "type": "object",
  "required": ["last_updated", "metadata", "upcoming_meetings"],
  "additionalProperties": false,
  "properties": {
    "last_updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO date this file was last written."
    },
    "metadata": {
      "type": "object",
      "required": ["time", "location"],
      "additionalProperties": false,
      "properties": {
        "time":                { "type": "string" },
        "location":            { "type": ["string", "null"] },
        "session_note":        { "type": "string" },
        "meetingScheduleNote": { "type": "string" }
      }
    },
    "upcoming_meetings": {
      "type": "array",
      "items": { "$ref": "#/$defs/upcomingMeeting" }
    },
    "meetings": {
      "type": "array",
      "items": { "$ref": "#/$defs/pastMeeting" }
    },
    "recordings": {
      "type": "array",
      "items": { "$ref": "#/$defs/recording" }
    },
    "removed_meetings": {
      "type": "array",
      "description": "Meetings the city removed from its calendar with no notice explaining it. Kept here for the record and never shown on the site. A meeting returns automatically if the city relists it, posts documents for it, or posts a notice about it.",
      "items": { "$ref": "#/$defs/removedMeeting" }
    }
  },
  "$defs": {
    "upcomingMeeting": {
       "type": "object",
       "required": ["date", "display"],
       "additionalProperties": false,
       "properties": {
         "date":        { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
         "display":     { "type": "string" },
         "time":        { "type": "string" },
         "location":    { "type": "string" },
         "isCancelled":     { "type": "boolean" },
            "isSpecial":       { "type": "boolean" },
            "locationChanged": { "type": "boolean" },
            "timeChanged": {
              "type": "boolean",
              "description": "True when a city notice moved this meeting to a new start time on the same date."
            },
            "previousTime": {
              "type": "string",
              "description": "The time this meeting was scheduled for before a notice changed it, so the site can say what it changed from."
            },
            "notOnCityCalendar": {
              "type": "boolean",
              "description": "True when this meeting is in our data but absent from the city calendar API with no notice explaining it. Kept and flagged rather than deleted."
            },
            "rescheduledFrom": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Set on a meeting that moved from an earlier date. The original date is removed from the calendar; this records where it moved from so the site can show a note."
            },
            "agenda_url":      { "type": ["string", "null"] }
       }
     },
    "pastMeeting": {
      "type": "object",
      "required": ["date", "display"],
      "additionalProperties": false,
      "properties": {
        "date":         { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "rescheduledFrom": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Set when this meeting moved from an earlier date. Kept after the meeting passes so the vacated date is never mistaken for a meeting that went missing and re-added from the city calendar."
        },
        "display":      { "type": "string" },
        "event_id":     { "type": "integer" },
        "url":          { "type": ["string", "null"] },
        "link_label":   { "type": "string" },
        "isCancelled":  { "type": "boolean" },
        "cancelNote": {
          "type": "string",
          "description": "Set when this meeting was marked cancelled because it is missing from the city's list of past meeting dates. Removed automatically if documents, a recording, or the city's listing later show it was held."
        },
        "minutes_url":  { "type": ["string", "null"] },
        "agenda_url":   { "type": ["string", "null"] },
        "scrapedAt":    { "type": ["string", "null"] },
        "sourceUrl":    { "type": ["string", "null"] },
        "meeting_type": { "type": "string" },
        "location":     { "type": ["string", "null"] },
        "youtube_id":   { "type": ["string", "null"] },
        "youtube_url":  { "type": ["string", "null"] },
        "hasRecordings": {
          "type": "boolean",
          "description": "True when YouTube recordings exist for this meeting."
        },
        "title": { "type": "string" }
      },
      "not": {
        "required": ["hasRecording"],
        "description": "Typo guard: 'hasRecording' (singular) is never valid. Use 'hasRecordings'."
      }
    },
    "removedMeeting": {
      "type": "object",
      "required": ["date", "display", "from", "removedOn"],
      "additionalProperties": false,
      "properties": {
        "date":      { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "display":   { "type": "string" },
        "from":      { "type": "string", "enum": ["upcoming", "archive"] },
        "removedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "reason":    { "type": "string" },
        "movedTo": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Set when the city moved this meeting to another date without a notice. A move is not a cancellation, so this meeting never comes back as cancelled."
        },
        "record":    { "type": "object", "description": "The meeting exactly as it was stored before it was removed." }
      }
    },
    "recording": {
      "type": "object",
      "required": ["date", "display", "youtube_id", "youtube_url"],
      "additionalProperties": false,
      "properties": {
        "date":        { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "display":     { "type": "string" },
        "youtube_id":  { "type": "string" },
        "youtube_url": { "type": "string" },
        "title":       { "type": "string" },
        "scrapedAt":   { "type": ["string", "null"] }
      }
    }
  }
}
